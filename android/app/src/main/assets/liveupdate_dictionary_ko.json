{
  "smart_rules": [
    {
      "id": "food",
      "max_stage": 4,
      "package_hints": [
        "kfc",
        "ubereats",
        "doordash",
        "grubhub",
        "delivery",
        "eats",
        "food",
        "meituan",
        "eleme",
        "foodpanda",
        "zepto",
        "zomato",
        "swiggy",
        "blinkit",
        "instamart",
        "bigbasket",
        "배달의민족",
        "쿠팡이츠",
        "요기요",
        "음식"
      ],
      "text_triggers": [
        "주문",
        "배달",
        "오더",
        "음식",
        "음식점",
        "레스토랑",
        "식당",
        "포장",
        "픽업",
        "라이더",
        "배달원",
        "배달대행",
        "야식",
        "간식"
      ],
      "exclude_patterns": [
        "(생일|생일 축하)",
        "(할인|쿠폰|세일|캐시백|혜택)",
        "신규 가입",
        "결제 실패"
      ],
      "signals": [
        {
          "stage": 4,
          "pattern": "(배달이 완료되었습니다.|만에 완료됐습니다.|배달이 도착했습니다|문 앞에 두었습니다|배송이 완료|픽업해 주세요|수령 완료)"
        },
        {
          "stage": 3,
          "pattern": "(라이더님이 곧 도착해요!|주문이 거의 도착했습니다.|잠시 후 도착|도착 예정입니다|근처에 도착)"
        },
        {
          "stage": 2,
          "pattern": "(라이더님이 배달을 시작했어요|배달원이 고객님의 음식을 픽업했습니다.|배달을 출발|픽업 완료|배송 시작)"
        },
        {
          "stage": 1,
          "pattern": "(주문이[^\\n](접수됐어요|수락되었습니다.)|조리가 시작|메뉴를 준비 중|주문 확인중)"
        },
        {
          "stage": 0,
          "pattern": "(주문 완료|결제 완료|주문이 접수 대기|결제가 승인)"
        }
      ]
    },
